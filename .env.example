# Copy to .env and fill in. Never commit .env.

# The data stock_news_analyzer collects, read through its read-only `shared` views
# (its docs/shared-data.md). The password is its SNA_READER_PASSWORD.
SHARED_DATABASE_URL=postgresql+psycopg://research_reader:research_reader@localhost:5433/sna

# This project's own database on the same Postgres server (created by `sdr db init`).
DATABASE_URL=postgresql+psycopg://sna:sna@localhost:5433/deep_research

# Claude, for the research agent.
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-sonnet-5-5
# A report stops before spending more than this, in US dollars.
REPORT_BUDGET_USD=5
